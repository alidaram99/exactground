{
  "description": "ExactGround: block installs of packages that do not exist (or look like typosquats) before the agent runs them. PreToolUse = Claude Code; BeforeTool = Gemini CLI.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/exactground.mjs",
              "hook",
              "claude"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "name": "exactground",
            "command": "node \"${extensionPath}/bin/exactground.mjs\" hook gemini",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
